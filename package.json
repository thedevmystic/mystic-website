{
  "name": "website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "pre": "pnpm run generate-blog-index && pnpm run generate-search-indexes",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "clean": "node scripts/clean.js",
    "generate-blog-index": "node scripts/generate-blog-index.js",
    "generate-search-indexes": "node scripts/generate-search-indexes.js",
    "update-deps": "pnpm dlx npm-check-updates -u -x eslint -x typescript"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "katex": "^0.18.5",
    "lenis": "^1.3.26",
    "lucide-react": "^1.38.0",
    "minisearch": "^7.2.0",
    "next": "16.3.4",
    "next-cloudinary": "^6.18.8",
    "nextjs-toploader": "^3.9.17",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "scroll-utils": "^1.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gray-matter": "^4.0.3",
    "next-tokens": "^1.1.3",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "typescript-eslint": "^8.69.0"
